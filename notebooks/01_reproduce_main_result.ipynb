   "source": [
    "## 2. Build CSV Artefacts\n",
    "\n",
    "`figures.py` reads CSV files. We generate them from `synthetic_results.json`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "cell-5",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-09T06:21:16.344415Z",
     "iopub.status.busy": "2026-08-09T06:21:16.344054Z",
     "iopub.status.idle": "2026-08-09T06:21:16.400746Z",
     "shell.execute_reply": "2026-08-09T06:21:16.399185Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Wrote 1080 rows to h1_replication.csv\n",
      "Wrote 360 rows to h2_transfer.csv\n",
      "Wrote 4 rows to h3_mismatch.csv\n",
      "Wrote 15 rows to self_similarity.csv\n"
     ]
    }
   ],
   "source": [
    "import csv\n",
    "\n",
    "CSV_DIR = RESULTS_DIR\n",
    "\n",
    "def _flatten_heatmap(hm):\n",
    "    \"\"\"Convert {'omission': {'functional': 25}, ...} -> {('omission','functional'): 25} \"\"\"\n",
    "    result = {}\n",
    "    for mt, cats in hm.items():\n",
    "        for fc, cnt in cats.items():\n",
    "            result[(mt, fc)] = cnt\n",
    "    return result\n",
    "\n",
    "# --- h1_replication.csv ---  one row per (spec_id, language, threshold)\n",
    "h1_rows = []\n",
    "for (spec_id, lang, impl_idx), entry in manifest.items():\n",
    "    tier = spec_id.split(\"-\")[0]\n",
    "    algo = spec_id.split(\"-\")[1]\n",
    "    for thresh, key in [(\"60\", \"threshold_60pct\"), (\"70\", \"threshold_70pct\"), (\"80\", \"threshold_80pct\")]:\n",
    "        rate = results[\"figures\"][\"fig1_h1_survival_by_threshold\"][key][\"survival_rate\"]\n",
    "        survived = results[\"figures\"][\"fig1_h1_survival_by_threshold\"][key][\"n_survived\"]\n",
    "        n = results[\"figures\"][\"fig1_h1_survival_by_threshold\"][key][\"n\"]\n",
    "        h1_rows.append({\n",
    "            \"spec_id\": spec_id,\n",
    "            \"tier\": tier,\n",
    "            \"algorithm_class\": algo,\n",
    "            \"language\": lang,\n",
    "            \"threshold\": thresh,\n",
    "            \"survived\": survived,\n",
    "            \"n\": n,\n",
    "            \"survival_rate\": rate,\n",
    "        })\n",
    "\n",
    "with open(CSV_DIR / \"h1_replication.csv\", \"w\", newline=\"\") as f:\n",
    "    writer = csv.DictWriter(f, fieldnames=[\"spec_id\",\"tier\",\"algorithm_class\",\"language\",\"threshold\",\"survived\",\"n\",\"survival_rate\"])\n",
    "    writer.writeheader()\n",
    "    writer.writerows(h1_rows)\n",
    "print(f\"Wrote {len(h1_rows)} rows to h1_replication.csv\")\n",
    "\n",
    "# --- h2_transfer.csv ---  one row per (spec_id, language)\n",
    "h2_rows = []\n",
    "for (spec_id, lang, impl_idx), entry in manifest.items():\n",
    "    tier = spec_id.split(\"-\")[0]\n",
    "    algo = spec_id.split(\"-\")[1]\n",
    "    cls_data = h2[\"transfer_by_class\"].get(algo, {})\n",
    "    rate = cls_data.get(\"transfer_rate\", 0.0)\n",
    "    n_specs = cls_data.get(\"n_specs\", 1)\n",
    "    transferred = int(rate * n_specs)\n",
    "    h2_rows.append({\n",
    "        \"spec_id\": spec_id,\n",
    "        \"tier\": tier,\n",
    "        \"algorithm_class\": algo,\n",
    "        \"language\": lang,\n",
    "        \"transferred\": transferred,\n",
    "        \"n_specs\": n_specs,\n",
    "        \"transfer_rate\": rate,\n",
    "    })\n",
    "\n",
    "with open(CSV_DIR / \"h2_transfer.csv\", \"w\", newline=\"\") as f:\n",
    "    writer = csv.DictWriter(f, fieldnames=[\"spec_id\",\"tier\",\"algorithm_class\",\"language\",\"transferred\",\"n_specs\",\"transfer_rate\"])\n",
    "    writer.writeheader()\n",
    "    writer.writerows(h2_rows)\n",
    "print(f\"Wrote {len(h2_rows)} rows to h2_transfer.csv\")\n",
    "\n",
    "# --- h3_mismatch.csv ---  one row per mismatch cell\n",
    "h3_rows = []\n",
    "for (key, cnt) in _flatten_heatmap(results[\"figures\"][\"fig3_h3_mismatch_heatmap\"]).items():\n",
    "    mismatch_type, failure_cat = key\n",
    "    h3_rows.append({\n",
    "        \"mismatch_type\": mismatch_type,\n",
    "        \"failure_category\": failure_cat,\n",
    "        \"count\": cnt,\n",
    "    })\n",
    "\n",
    "with open(CSV_DIR / \"h3_mismatch.csv\", \"w\", newline=\"\") as f:\n",
    "    writer = csv.DictWriter(f, fieldnames=[\"mismatch_type\",\"failure_category\",\"count\"])\n",
    "    writer.writeheader()\n",
    "    writer.writerows(h3_rows)\n",
    "print(f\"Wrote {len(h3_rows)} rows to h3_mismatch.csv\")\n",
    "\n",
    "# --- self_similarity.csv ---  one row per language pair\n",
    "ss_rows = []\n",
    "for pair, jaccard in results[\"self_similarity\"][\"avg_jaccard_by_pair\"].items():\n",
    "    lang1, lang2 = pair.split(\"↔\")\n",
    "    ss_rows.append({\"lang1\": lang1, \"lang2\": lang2, \"jaccard\": jaccard})\n",
    "\n",
    "with open(CSV_DIR / \"self_similarity.csv\", \"w\", newline=\"\") as f:\n",
    "    writer = csv.DictWriter(f, fieldnames=[\"lang1\",\"lang2\",\"jaccard\"])\n",
    "    writer.writeheader()\n",
    "    writer.writerows(ss_rows)\n",
    "print(f\"Wrote {len(ss_rows)} rows to self_similarity.csv\")"
   ]
  },
