    "# Group by language, threshold — mean survival rate\n",
    "h1_fig = h1_df.groupby([\"language\", \"threshold\"])[\"survival_rate\"].mean().unstack()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 5))\n",
    "x = np.arange(len(h1_fig.index))\n",
    "width = 0.25\n",
    "for i, thresh in enumerate([\"60\", \"70\", \"80\"]):\n",
    "    vals = [h1_fig.loc[lang, thresh] if thresh in h1_fig.columns else 0 for lang in h1_fig.index]\n",
    "    bars = ax.bar(x + (i - 1) * width, vals, width, label=f\"{thresh}%\", color=plt.cm.tab10(i))\n",
    "    for bar, v in zip(bars, vals):\n",
    "        ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + 0.005,\n",
    "                f\"{v:.1%}\", ha=\"center\", va=\"bottom\", fontsize=7, rotation=45)\n",
    "\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels(h1_fig.index)\n",
    "ax.set_ylabel(\"Survival Rate\")\n",
    "ax.set_xlabel(\"Language\")\n",
    "ax.set_title(\"Figure 1 — H1: Within-Language Invariant Survival by Threshold\")\n",
    "ax.set_ylim(0, 1.15)\n",
    "ax.axhline(0.5, color=\"gray\", linestyle=\"--\", linewidth=0.8, label=\"Chance (50%)\")\n",
    "ax.legend(title=\"Threshold\")\n",
    "ax.yaxis.set_major_formatter(plt.FuncFormatter(lambda y, _: f\"{y:.0%}\"))\n",
    "plt.tight_layout()\n",
    "out = FIGURES_DIR / \"fig1_h1_survival_by_threshold.png\"\n",
    "plt.savefig(out, dpi=300, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "print(f\"Saved: {out}\")"
   ]
  },
