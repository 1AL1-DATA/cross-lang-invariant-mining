   "source": [
    "from power_analysis import full_power_analysis\n",
    "\n",
    "pa = full_power_analysis(\n",
    "    pilot_data=[],\n",
    "    effect_size=0.5,\n",
    "    alpha=0.05,\n",
    "    power=0.8,\n",
    ")\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(11, 4))\n",
    "\n",
    "# Power curve\n",
    "alphas = [0.01, 0.05, 0.10]\n",
    "for alpha in alphas:\n",
    "    ns = list(range(2, 31))\n",
    "    powers = []\n",
    "    for n in ns:\n",
    "        from scipy import stats\n",
    "        z_beta = stats.norm.ppf(1 - alpha)\n",
    "        z_alpha = stats.norm.ppf(0.975)\n",
    "        d = 0.5\n",
    "        ncp = d * np.sqrt(n / 2)\n",
    "        power = 1 - stats.norm.cdf(z_alpha - ncp) + stats.norm.cdf(-z_alpha - ncp)\n",
    "        powers.append(power)\n",
    "    axes[0].plot(ns, powers, label=f\"alpha={alpha}\")\n",
    "axes[0].axhline(0.8, color=\"gray\", linestyle=\"--\", linewidth=0.8)\n",
    "axes[0].set_xlabel(\"N per cell\")\n",
    "axes[0].set_ylabel(\"Power\")\n",
    "axes[0].set_title(\"Power vs N (d=0.5, two-tailed)\")\n",
    "axes[0].legend()\n",
    "\n",
    "# Effect size sensitivity\n",
    "ds = [0.2, 0.5, 0.8]\n",
    "for d in ds:\n",
    "    ns = list(range(2, 61))\n",
    "    powers = []\n",
    "    for n in ns:\n",
    "        from scipy import stats\n",
    "        z_alpha = stats.norm.ppf(0.975)\n",
    "        ncp = d * np.sqrt(n / 2)\n",
    "        power = 1 - stats.norm.cdf(z_alpha - ncp) + stats.norm.cdf(-z_alpha - ncp)\n",
    "        powers.append(power)\n",
    "    axes[1].plot(ns, powers, label=f\"d={d}\")\n",
    "axes[1].axhline(0.8, color=\"gray\", linestyle=\"--\", linewidth=0.8)\n",
    "axes[1].set_xlabel(\"N per cell\")\n",
    "axes[1].set_ylabel(\"Power\")\n",
    "axes[1].set_title(\"Power vs N (alpha=0.05)\")\n",
    "axes[1].legend(title=\"Effect size\")\n",
    "\n",
    "plt.suptitle(f\"Phase 0b — Power Analysis  |  Required N={pa.required_n}\", fontsize=11, fontweight=\"bold\")\n",
    "plt.tight_layout()\n",
    "out = FIGURES_DIR / \"fig7_power_analysis.png\"\n",
