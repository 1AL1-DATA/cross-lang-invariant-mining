  "type": "program",
  "text": "export function fibonacci(n: number): number {\n    if (n <= 1) {\n        return n;\n    }\n    let prev = 0;\n    let curr = 1;\n    for (let i = 1; i < n; i++) {\n        const next = prev + curr;\n        prev = curr;\n        curr = next;\n    }\n    return curr;\n}",
