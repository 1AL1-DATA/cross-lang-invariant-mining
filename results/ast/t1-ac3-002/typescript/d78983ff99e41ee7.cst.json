{
  "type": "program",
  "text": "function fibonacci(n: number): number {\n    if (n === 0) return 0;\n    if (n === 1) return 1;\n    \n    let prev = 0;\n    let curr = 1;\n    \n    for (let i = 2; i <= n; i++) {\n        const next = prev + curr;\n        prev = curr;\n        curr = next;\n    }\n    \n    return curr;\n}",
