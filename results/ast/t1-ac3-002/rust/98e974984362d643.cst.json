  "text": "pub fn fibonacci(n: u32) -> i32 {\n    if n == 0 {\n        return 0;\n    }\n    let mut prev = 0i32;\n    let mut curr = 1i32;\n    for _ in 1..n {\n        let next = prev + curr;\n        prev = curr;\n        curr = next;\n    }\n    curr\n}",
