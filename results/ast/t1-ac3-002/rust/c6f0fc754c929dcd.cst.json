  "type": "source_file",
  "text": "fn fibonacci(n: u32) -> u32 {\n    if n == 0 {\n        return 0;\n    }\n    if n == 1 {\n        return 1;\n    }\n    \n    let mut prev = 0;\n    let mut curr = 1;\n    \n    for _ in 2..=n {\n        let next = prev + curr;\n        prev = curr;\n        curr = next;\n    }\n    \n    curr\n}",
