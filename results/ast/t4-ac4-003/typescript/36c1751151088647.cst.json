  "type": "program",
  "text": "type UnaryFunction = (x: number) => number;\n\nfunction composeNFunctions(funcs: UnaryFunction[], x: number): number {\n    let result = x;\n    for (const func of funcs) {\n        result = func(result);\n    }\n    return result;\n}\n\nexport default composeNFunctions;",
