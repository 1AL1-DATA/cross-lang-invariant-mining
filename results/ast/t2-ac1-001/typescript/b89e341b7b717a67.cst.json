  "text": "function countCharacterFrequency(s: string): Record<string, number> {\n    const counts: Record<string, number> = {};\n    \n    for (const char of s) {\n        counts[char] = (counts[char] ?? 0) + 1;\n    }\n    \n    return counts;\n}",
