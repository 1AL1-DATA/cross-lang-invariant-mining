{
  "type": "program",
  "text": "function factorial(n: number): number {\n    if (n < 0) {\n        throw new Error(\"n must be non-negative\");\n    }\n    if (n > 20) {\n        throw new Error(\"n must be at most 20\");\n    }\n    \n    let result = 1;\n    for (let i = 2; i <= n; i++) {\n        result *= i;\n    }\n    return result;\n}",
