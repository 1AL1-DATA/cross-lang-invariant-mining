{
  "type": "program",
  "text": "export function factorial(n: number): number {\n    if (n < 0 || n > 20) {\n        throw new Error(\"n must be between 0 and 20\");\n    }\n    \n    let result = 1;\n    for (let i = 2; i <= n; i++) {\n        result *= i;\n    }\n    \n    return result;\n}",
  "start_point": [
