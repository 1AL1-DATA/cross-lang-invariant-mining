{
  "type": "source_file",
  "text": "pub fn factorial(n: i32) -> u64 {\n    if n < 0 {\n        panic!(\"Factorial is undefined for negative numbers\");\n    }\n    let n = n as u32;\n    if n > 20 {\n        panic!(\"Factorial overflow: n must be <= 20\");\n    }\n    let mut result: u64 = 1;\n    for i in 1..=n {\n        result *= u64::from(i);\n    }\n    result\n}",
