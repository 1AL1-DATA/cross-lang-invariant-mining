{
  "type": "source_file",
  "text": "pub fn factorial(n: i32) -> u64 {\n    if n < 0 || n > 20 {\n        panic!(\"n must be between 0 and 20 inclusive\");\n    }\n    let mut result: u64 = 1;\n    for i in 1..=n as u64 {\n        result *= i;\n    }\n    result\n}",
